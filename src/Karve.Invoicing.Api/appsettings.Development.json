{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.Identity.Web": "Information",
      "Microsoft.IdentityModel": "Information"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "karve-invoicing-api",
    "Environment": "Development",
    "EnableTraces": true,
    "EnableMetrics": true,
    "EnableLogs": true
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "MicrosoftMinimumLevel": "Warning",
    "EnableJsonConsole": true
  },
  "Email": {
    "SmtpHost": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@localhost",
    "EnableSsl": false
  },
  "BackgroundJobs": {
    "OverdueInvoiceCheckIntervalMinutes": 5
  }
}
